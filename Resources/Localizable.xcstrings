    "Gravity-derived; axis orientation is model-dependent." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "由重力派生；坐标轴方向取决于机型。" } } } },
    "HID manager could not be opened" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开 HID 管理器" } } } },
    "HID open result: %@." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "HID 打开结果：%@。" } } } },
    "Hardware/service presence only." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅表示硬件或服务存在。" } } } },
    "Internal component temperature, not ambient room temperature." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内部组件温度，并非室内环境温度。" } } } },
    "Internal SMC telemetry; not wall-plug power." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内部 SMC 遥测；并非插座侧功率。" } } } },
    "Lid sensor detected but could not be opened" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到上盖传感器，但无法打开" } } } },
    "Lid sensor did not return a feature report" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上盖传感器未返回功能报告" } } } },
    "Lid sensor returned an out-of-range value" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上盖传感器返回了超出范围的值" } } } },
    "Live %@ data" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时%@数据" } } } },
    "Load average (%lld min)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "平均负载（%lld 分钟）" } } } },
    "Memory and swap counters available" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内存与 Swap 计数器可用" } } } },
