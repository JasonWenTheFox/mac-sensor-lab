    "Read Camera Capabilities" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取相机能力" } } } },
    "Reading bounded local camera capabilities…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在读取有界的本地相机能力…" } } } },
    "Reported formats" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统报告的格式数" } } } },
    "The app bundle is missing its Continuity Camera classification boundary." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用包缺少审定的 Continuity Camera 分类边界。" } } } },
    "Transport" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传输类型" } } } },
    "Unspecified" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未指定" } } } },
    "sRGB" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "sRGB" } } } },
    "Analyzed observations" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已分析观测" } } } },
    "Camera Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机检查" } } } },
    "Camera Check stopped after a capture-session error." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采集会话出错后，相机检查已停止。" } } } },
    "Camera Check stopped after an invalid or unsupported frame." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到无效或不受支持的帧后，相机检查已停止。" } } } },
    "Camera Check stopped at the two-minute safety limit." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机检查已在两分钟安全上限处停止。" } } } },
    "Camera Check stopped because a frame counter exceeded its safety limit." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "帧计数超过安全上限，相机检查已停止。" } } } },
    "Camera Check stopped because macOS interrupted the capture session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 中断了采集会话，相机检查已停止。" } } } },
    "Camera Check stopped because the Continuity Camera classification boundary is missing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "缺少 Continuity Camera 分类边界，相机检查已停止。" } } } },
    "Camera Check stopped because the app is closing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "App 正在关闭，相机检查已停止。" } } } },
    "Camera Check stopped because the selected local camera disconnected." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选中的本地相机已断开，相机检查已停止。" } } } },
    "Camera Check stopped before the Mac went to sleep." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 进入睡眠前已停止相机检查。" } } } },
    "Camera Check stopped; bounded derived values remain until this page is left." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机检查已停止；有界派生值会保留到离开本页。" } } } },
    "Camera access is denied. Change it in System Settings if desired, then check again." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机访问已被拒绝。如需可在“系统设置”中更改，然后重新检查。" } } } },
    "Camera access is restricted by the current system policy." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前系统策略限制了相机访问。" } } } },
    "Continue to Camera Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续启动相机检查" } } } },
    "Delivered frames" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已传递帧" } } } },
    "Idle — camera input has not started." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲——相机输入尚未开始。" } } } },
    "Idle — demo mode will not access the camera." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲——演示模式不会访问相机。" } } } },
    "If Camera access is undecided, macOS will ask now. Otherwise the bounded preview starts immediately. Frames remain in memory and are never saved or exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如果尚未决定相机权限，macOS 现在会发起询问；否则会立即启动有界预览。画面只保留在内存中，绝不保存或导出。" } } } },
    "No supported local built-in or external camera was available." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可用的受支持本机内置或外接相机。" } } } },
    "Observed delivery rate" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测传递帧率" } } } },
    "Observed frame size" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测帧尺寸" } } } },
    "Output-dropped frames" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输出丢弃帧" } } } },
    "Pixels sampled per analysis" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次分析采样像素" } } } },
    "Previewing and reducing frames in memory." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在内存中预览并归约画面帧。" } } } },
    "Raw BGRA frames are sampled only inside the capture callback and immediately reduced to at most 4,096 relative-luma samples. No frame, recording, photo, audio, device identity, persistence, snapshot, diagnostics value, or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始 BGRA 帧只在采集回调内采样，并立即归约为最多 4,096 个相对亮度样本。不保留帧、录像、照片、音频或设备身份，不持久化，也不进入快照、诊断值或导出。" } } } },
    "Relative luma is an uncalibrated digital image statistic, not lux, exposure, ambient brightness, display brightness, or camera quality. The session stops after two minutes at most." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相对亮度是未经校准的数字图像统计，不是 lux、曝光、环境亮度、显示器亮度或相机质量。会话最长两分钟后停止。" } } } },
    "Review the camera privacy explanation before continuing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续前请查看相机隐私说明。" } } } },
    "Run Demo Camera Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行演示相机检查" } } } },
    "Sampled luma span" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采样亮度跨度" } } } },
    "Sampled relative luma" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采样相对亮度" } } } },
    "Start Camera Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始相机检查" } } } },
    "Start Camera Check with local video input?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要使用本地视频输入启动相机检查吗？" } } } },
    "Starting the bounded camera session…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在启动有界的相机会话…" } } } },
    "Starts a bounded local-camera preview only after a two-step action and derives relative digital luma and observed frame delivery in memory." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有经过两步操作才会启动有界的本地相机预览，并在内存中派生相对数字亮度与观测帧传递情况。" } } } },
    "Stop Camera Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止相机检查" } } } },
    "Synthetic demo frame — no camera access" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "合成演示画面——未访问相机" } } } },
    "The Camera permission request did not produce an authorized state." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机权限请求未得到已授权状态。" } } } },
    "The local camera session could not be configured." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法配置本地相机会话。" } } } },
    "The local camera session could not start." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法启动本地相机会话。" } } } },
    "Waiting for another observation" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待下一次观测" } } } },
    "Waiting for the macOS Camera decision…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待 macOS 的相机权限决定…" } } } },
    "Version" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本" } }
      }
    }
  },
  "version": "1.0"
