    "pixels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "像素" } } } },
    "points" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点" } } } },
    "×" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "×" } } } },
    "AGX PerformanceStatistics keys are undocumented and may change across macOS or GPU generations." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AGX PerformanceStatistics 键未文档化，可能随 macOS 或 GPU 代际而变化。" } } } },
    "Average number of processes in the system run queue; not CPU percent." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统运行队列中的平均进程数；不是 CPU 百分比。" } } } },
    "Battery-side power is not whole-system wall power." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电池侧功率并非整机插座侧功率。" } } } },
    "Counters aggregate active non-loopback interfaces without exporting their names or addresses." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "计数器汇总活动的非回环接口，不导出其名称或地址。" } } } },
    "CPU generation selects an allowlist only; the brand string is not retained or exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "CPU 代际仅用于选择白名单；品牌字符串不会被保留或导出。" } } } },
    "CPU generation was not recognized; only fixed generation-neutral temperature, fan and power keys were read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未识别 CPU 代际；仅读取固定的代际中立温度、风扇和功率键。" } } } },
    "CPU utilization needs two samples; the first read establishes a baseline." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "CPU 利用率需要两次采样；首次读取用于建立基线。" } } } },
    "Desktop Macs may not expose AppleSmartBattery." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "桌面 Mac 可能不暴露 AppleSmartBattery。" } } } },
    "Detection does not prove continuous read permission." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到硬件并不证明拥有连续读取权限。" } } } },
    "Malformed provider output was discarded before display or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "格式异常的 Provider 输出已在显示或导出前丢弃。" } } } },
    "Memory channels are raw Mach page categories and may overlap conceptually with UI labels used by other tools." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内存通道是原始 Mach 页面类别，在概念上可能与其他工具的 UI 标签重叠。" } } } },
    "Multiple driver instances use the maximum utilization and summed memory counters." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存在多个驱动实例时，利用率取最大值，内存计数器求和。" } } } },
    "No Apple SPU driver properties were changed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有更改任何 Apple SPU 驱动属性。" } } } },
    "No device names, serial numbers, volume names, or file paths are read or exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不读取或导出设备名称、序列号、卷名称或文件路径。" } } } },
    "No device names, serial numbers, volume names, or file paths are read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不读取设备名称、序列号、卷名称或文件路径。" } } } },
    "No driver properties were changed and no privileged access was attempted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未更改驱动属性，也未尝试特权访问。" } } } },
    "No driver state was changed and no privileged access was attempted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未更改驱动状态，也未尝试特权访问。" } } } },
    "No interface names or network addresses were exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未导出接口名称或网络地址。" } } } },
    "No private data fields are read during capability discovery." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "能力发现期间不读取私有数据字段。" } } } },
    "No process list or identifying information was requested." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未请求进程列表或身份识别信息。" } } } },
    "No SMC write or fan-control method exists in this target." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 Target 中不存在 SMC 写入或风扇控制方法。" } } } },
    "No sudo, driver-property writes, or permission bypass was attempted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未尝试 sudo、写入驱动属性或绕过权限。" } } } },
    "Only a fixed allowlist of non-identifying registry keys is read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅读取不含身份信息的固定注册表键白名单。" } } } },
    "Only a fixed allowlist of utilization and memory counters is requested; no device identity fields are read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅请求固定白名单中的利用率和内存计数器；不读取设备身份字段。" } } } },
    "Only fixed allowlisted counters are read; no registry names, IDs, or device identity fields are exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅读取固定白名单计数器；不导出注册表名称、ID 或设备身份字段。" } } } },
    "Presence only; continuous access may require additional permission." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅表示存在；连续访问可能需要额外权限。" } } } },
    "Rates need two samples; a counter reset or device change starts a new baseline." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "速率需要两次采样；计数器重置或设备变化会开始新的基线。" } } } },
    "Rates need two samples; the first read or an active-interface count change establishes a baseline." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "速率需要两次采样；首次读取或活动接口数量变化时会建立基线。" } } } },
    "Pixel and point dimensions are the current display mode; scale is derived. Persistent display identifiers are intentionally omitted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "像素与点尺寸来自当前显示模式，缩放倍率为派生值；有意省略持久显示器标识符。" } } } },
    "Synthetic demo data; not a hardware reading." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "合成演示数据；并非硬件读数。" } } } },
    "The App will not request sudo or alter HID driver properties." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本 App 不会请求 sudo 或更改 HID 驱动属性。" } } } },
    "The App will not request sudo or attempt a privileged helper in this build." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此构建不会请求 sudo，也不会尝试特权 Helper。" } } } },
    "The safe reader did not wake or reconfigure the SPU." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安全读取器没有唤醒或重新配置 SPU。" } } } },
    "Thermal pressure is a public system state, not a temperature in degrees." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "热压力是公开的系统状态，不是以度数表示的温度。" } } } },
    "Totals are driver-lifetime counters aggregated across block-storage drivers." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "总计是跨块存储驱动汇总的驱动生命周期计数器。" } } } },
    "Undocumented formats are provisional and must be validated per model." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未文档化的格式是暂定的，必须按机型验证。" } } } },
    "Undocumented key meanings require anonymous cross-model validation." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未文档化的键含义需要匿名跨机型验证。" } } } },
    "Virtual or tunneled paths can represent the same traffic more than once." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "虚拟或隧道路径可能会重复表示同一流量。" } } } },
