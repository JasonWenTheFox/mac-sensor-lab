    "CDC data" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "CDC 数据" } } } },
    "Child of USB Device %lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 设备 %lld 的子设备" } } } },
    "Communications" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通信" } } } },
    "Connection speed" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接速度" } } } },
    "Connection speed is a reported link category, not a maximum capability or measured throughput." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接速度是系统报告的链路类别，不是最大能力或实测吞吐量。" } } } },
    "Content security" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内容安全" } } } },
    "Current configuration value" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前配置值" } } } },
    "Defined by interfaces" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "由接口定义" } } } },
    "Device class / subclass / protocol" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备类别 / 子类别 / 协议" } } } },
    "Device release number (bcdDevice)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备发布编号（bcdDevice）" } } } },
    "Diagnostic" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "诊断" } } } },
    "Full Speed — 12 Mb/s" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全速 — 12 Mb/s" } } } },
    "High Speed — 480 Mb/s" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高速 — 480 Mb/s" } } } },
    "Hub" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "集线器" } } } },
    "Human interface device" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "人机接口设备" } } } },
    "Idle — the USB tree has not been read this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲——本次会话尚未读取 USB 树。" } } } },
    "Image" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "图像" } } } },
    "Interface %lld.%lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接口 %lld.%lld" } } } },
    "Interface class / subclass / protocol" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接口类别 / 子类别 / 协议" } } } },
    "Interface number" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接口编号" } } } },
    "Load Demo USB Tree" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "载入演示 USB 树" } } } },
    "Low Speed — 1.5 Mb/s" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "低速 — 1.5 Mb/s" } } } },
