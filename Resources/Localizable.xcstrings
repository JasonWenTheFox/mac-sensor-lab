    "No network name, access-point address, interface identity, location, or scan results are collected." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不收集网络名称、接入点地址、接口身份、位置或扫描结果。" } } } },
    "No SSID, BSSID, MAC address, country code, interface name, scan result, IP address, or location was read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未读取 SSID、BSSID、MAC 地址、国家代码、接口名称、扫描结果、IP 地址或位置。" } } } },
