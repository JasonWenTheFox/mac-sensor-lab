    "Thermal pressure level" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "热压力等级" } } } },
    "Thermal Trend" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "热压力趋势" } } } },
    "Tracks public pressure states as an ordinal history, not temperature" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将公开热压力状态记录为序数历史，而非温度" } } } },
    "Tracks internal SMC power telemetry; not wall-plug power" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟踪内部 SMC 功耗遥测；不是插座侧功率" } } } },
    "Highest recent pressure" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "近期最高热压力" } } } },
    "State changes" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "状态变化" } } } },
    "%lld samples retained. Ordinal spacing is not physical and no temperature is inferred." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留 %lld 个样本。序数间距没有物理意义，也不推断温度。" } } } },
    "Ordinal encoding for trend display only; level spacing is not physical and no temperature is inferred." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "序数编码仅用于趋势显示；等级间距没有物理意义，也不推断温度。" } } } },
    "Thermals" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "散热状态" } } } },
    "Used" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已使用" } } } },
    "Write errors" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入错误" } } } },
    "Write operation rate" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写操作速率" } } } },
    "Write operations" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写操作" } } } },
    "macOS" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS" } } } },
    "Active power source" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前供电来源" } } } },
    "Early warning" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "早期告警" } } } },
    "Final warning" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最终告警" } } } },
    "No warning" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无告警" } } } },
    "Operating-system warning level; time thresholds are estimates, not guarantees." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "操作系统告警级别；时间阈值是估算，不是保证。" } } } },
    "System low-battery warning" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统低电量告警" } } } },
    "Battery charge (public API)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电池电量（公开 API）" } } } },
    "Battery charging (public API)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电池充电状态（公开 API）" } } } },
    "Battery time to empty (public API)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电池预计耗尽时间（公开 API）" } } } },
    "Battery time to full (public API)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电池预计充满时间（公开 API）" } } } },
    "Battery-specific operating-system estimate; calculating sentinels are omitted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "操作系统针对电池的估算值；已省略‘正在计算’哨兵值。" } } } },
    "Current Capacity ÷ Max Capacity from Apple's public power-source API." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 公开电源 API 返回的当前容量 ÷ 最大容量。" } } } },
    "Power-source names, IDs, serial numbers, transport details, and adapter metadata are intentionally ignored." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有意忽略电源名称、ID、序列号、传输详情和电源适配器元数据。" } } } },
    "Public power-source information available" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公开电源信息可用" } } } },
    "Public power-source information returned no allowlisted values" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公开电源信息未返回白名单值" } } } },
    "Public power-source information was unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公开电源信息不可用" } } } },
    "System Power Source" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统电源来源" } } } },
    "System time remaining" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统估算剩余时间" } } } },
    "System-wide IOPowerSources estimate for the active limited power source." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "IOPowerSources 对当前有限供电来源给出的系统级估算。" } } } },
    "Time remaining values are operating-system estimates." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "剩余时间值是操作系统估算。" } } } },
    "UPS power" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "UPS 电源" } } } },
    "Uses Apple's public IOPowerSources API." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 Apple 公开的 IOPowerSources API。" } } } },
    "%lld status changes this launch" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本次启动发生 %lld 次状态切换" } }
      }
    },
    "View Diagnostics" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看诊断" } }
      }
    },
    "Acceleration, level, and ambient-light fixture data" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加速度、水平与环境光演示数据" } } } },
    "Available SMC channels vary by Mac model and macOS version." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可用的 SMC 通道会随 Mac 机型和 macOS 版本变化。" } } } },
    "Available-space values use the current Foundation volume semantics." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可用空间数值采用当前 Foundation 的卷语义。" } } } },
    "AppleSMC could not be opened" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开 AppleSMC" } } } },
    "AppleSMC is not available on this Mac" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 不提供 AppleSMC" } } } },
    "AppleSMC is temporarily busy" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AppleSMC 暂时繁忙" } } } },
    "Clear Reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除参考" } } } },
    "Cleared the light-spectrum reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已清除光谱参考" } } } },
    "Compares the relative balance of four uncalibrated light channels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "比较四个未校准光通道的相对比例" } } } },
    "Compares recent aggregate read and write rates" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "比较近期汇总读写速率" } } } },
    "Compares recent aggregate receive and send rates" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "比较近期汇总接收与发送速率" } } } },
    "Choose a tool to interpret, compare, or calibrate recent sensor data." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择工具来解释、比较或校准近期传感器数据。" } } } },
    "Data access" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "数据访问" } } } },
    "Data source error" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "数据源出错" } } } },
    "Detection alone does not guarantee that live reports are available." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到硬件并不保证当前有实时报告。" } } } },
    "Hardware detected • measurement in development" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已检测到硬件 • 测量功能开发中" } } } },
    "In development" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开发中" } } } },
    "Largest shift" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "变化最大的通道" } } } },
    "Light Spectrum" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "光谱对比" } } } },
    "macOS denied access to AppleSMC" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 拒绝访问 AppleSMC" } } } },
    "macOS denied access to the lid-angle sensor" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 拒绝访问上盖角度传感器" } } } },
    "Match to reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与参考的匹配度" } } } },
    "Other sensors will continue updating while this read finishes." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这次读取完成前，其他传感器仍会继续更新。" } } } },
    "Pixel and point dimensions describe the current display mode; scale is derived." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "像素与点尺寸描述当前显示模式；缩放倍率为派生值。" } } } },
    "Relative channel balance" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相对通道比例" } } } },
    "Replace Reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "替换参考" } } } },
    "Saved the current light spectrum as a reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已将当前光谱保存为参考" } } } },
    "Sensor read is taking longer than expected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传感器读取时间超过预期" } } } },
    "Sensor access is read-only and does not change system settings." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传感器访问为只读，不会更改系统设置。" } } } },
    "Sensor access is read-only. Unavailable sources stay isolated from the rest of the app." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传感器访问为只读；不可用的数据源不会影响应用的其他部分。" } } } },
    "Set Current as Reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将当前值设为参考" } } } },
    "The current spectral sample cannot be used as a reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前光谱样本无法作为参考" } } } },
    "The support report contains sensor availability and channel types, but no readings." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "支持报告包含传感器可用性和通道类型，但不包含读数。" } } } },
    "The lid-angle sensor could not be opened" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开上盖角度传感器" } } } },
    "The lid-angle sensor is not available on this Mac" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 不提供上盖角度传感器" } } } },
    "The lid-angle sensor is temporarily busy" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上盖角度传感器暂时繁忙" } } } },
    "This fingerprint compares light sources on this Mac; it is not a color-temperature measurement." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个指纹用于比较本机上的光源变化，不是色温测量。" } } } },
    "Required reading unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所需读数不可用" } } } },
    "%lld accepted records across %lld channels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已接受 %lld 条记录，分布于 %lld 个信道" } } } },
    "%lld malformed records discarded • %lld records omitted by the safety limit" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已丢弃 %lld 条异常记录 • 安全上限省略了 %lld 条记录" } } } },
    "%lld records" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 条记录" } } } },
    "A Wi-Fi interface was not reported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统未报告 Wi-Fi 接口。" } } } },
    "A short cooldown prevents repeated scans." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "短暂冷却可避免重复扫描。" } } } },
    "Cancel" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "Channel %lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信道 %lld" } } } },
    "Channel snapshot available for this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本次会话的信道快照已可用。" } } } },
    "CoreWLAN reported that the scan timed out." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "CoreWLAN 报告扫描超时。" } } } },
    "Demo mode uses fixed, non-identifying fixture data and does not access Wi-Fi hardware." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "演示模式使用固定、不可识别身份的样例数据，不访问 Wi-Fi 硬件。" } } } },
    "Idle — no nearby scan has run this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲 — 本次会话尚未运行附近信道扫描。" } } } },
    "Nearby Wi-Fi Channels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "附近 Wi-Fi 信道" } } } },
    "No network name, access-point address, country code, interface identity, information elements, location, persistence, or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不读取网络名称、接入点地址、国家代码、接口身份、信息元素或位置，也不持久化或导出。" } } } },
    "RSSI unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RSSI 不可用" } } } },
    "Reported records and RSSI are a momentary view of advertisements, not airtime use, interference, throughput, or a complete congestion measurement." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "报告的记录数与 RSSI 只是广播信号的瞬时视图，不代表空口占用、干扰、吞吐量或完整的拥塞测量。" } } } },
    "Run Demo Scan" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行演示扫描" } } } },
    "Run one demo scan?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行一次演示扫描？" } } } },
    "Run one nearby-channel scan?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行一次附近信道扫描？" } } } },
    "Runs one user-started CoreWLAN scan and immediately reduces the result to radio-channel summaries." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在用户主动操作后运行一次 CoreWLAN 扫描，并立即将结果缩减为无线电信道摘要。" } } } },
    "Scan Nearby Channels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描附近信道" } } } },
    "Scanning briefly uses the Wi-Fi radio and can momentarily affect connectivity. Results stay in this panel and omit network identities." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描会短暂使用 Wi-Fi 无线电，可能瞬时影响连接。结果只保留在此面板中，并省略网络身份。" } } } },
    "Start One Scan" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始一次扫描" } } } },
    "Stop Waiting" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止等待" } } } },
    "Stopped waiting after 20 seconds; any late result will be discarded." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待 20 秒后已停止；任何迟到结果都将被丢弃。" } } } },
    "Stopped waiting; any late system result will be discarded." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止等待；任何迟到的系统结果都将被丢弃。" } } } },
    "The Wi-Fi network service is inactive or unavailable." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Wi-Fi 网络服务未启用或不可用。" } } } },
    "The Wi-Fi scan failed without exposing system error details." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Wi-Fi 扫描失败；未暴露系统错误详情。" } } } },
    "The scan completed without usable channel records." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描已完成，但没有可用的信道记录。" } } } },
    "The system scan may still be finishing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统扫描可能仍在结束过程中。" } } } },
    "This Wi-Fi scan is not supported on the current system." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前系统不支持此 Wi-Fi 扫描。" } } } },
    "Waiting for the system Wi-Fi scan…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待系统 Wi-Fi 扫描…" } } } },
    "Wi-Fi is off or its power state is unavailable." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Wi-Fi 已关闭或其电源状态不可用。" } } } },
    "macOS did not permit this Wi-Fi scan." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 未允许此次 Wi-Fi 扫描。" } } } },
    "%@ fps" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ fps" } } } },
    "%@–%@ fps" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@–%@ fps" } } } },
    "%lld capability rows" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 行能力" } } } },
    "%lld equivalent formats" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个等价格式" } } } },
    "%lld excluded devices • %lld malformed or unknown fields omitted" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已排除 %lld 台设备 • 已省略 %lld 个异常或未知字段" } } } },
    "%lld supported local cameras • %lld capability rows" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 台受支持的本地相机 • %lld 行能力" } } } },
    "%lld × %lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld × %lld" } } } },
    "Autofocus system" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动对焦系统" } } } },
    "Back" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "后置" } } } },
    "Built-in wide-angle camera" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内置广角相机" } } } },
    "Camera %lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机 %lld" } } } },
    "Camera Capabilities" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机能力" } } } },
    "Camera capabilities are available on this page for this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机能力仅在本次会话的此页面可用。" } } } },
    "Camera capabilities are available with unsupported metadata omitted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机能力可用；已省略不受支持的元数据。" } } } },
    "Camera capability discovery failed without exposing system error text." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机能力发现失败，未回显系统错误文本。" } } } },
    "Camera capability discovery is temporarily unavailable." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机能力发现暂时不可用。" } } } },
    "Camera discovery may still be finishing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机发现可能仍在结束。" } } } },
    "Camera metadata changed shape or was malformed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机元数据结构发生变化或格式异常。" } } } },
    "Camera metadata exceeded its safety limit and was not shown." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相机元数据超过安全上限，因此未显示。" } } } },
    "Color spaces" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "色彩空间" } } } },
    "Continuity Camera and Desk View are excluded by device type and transport classification." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Continuity Camera 与桌面视角会按设备类型和传输分类排除。" } } } },
    "Contrast detection" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对比度检测" } } } },
    "Device type" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备类型" } } } },
    "Discovers one bounded set of local camera formats only after you ask. No camera permission is requested and no device is opened." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在你主动操作后发现一次有界的本地相机格式集合。不请求相机权限，也不打开设备。" } } } },
    "External camera" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "外接相机" } } } },
    "Frame rate range" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "帧率范围" } } } },
    "Front" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "前置" } } } },
    "Idle — camera capabilities have not been read this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲——本次会话尚未读取相机能力。" } } } },
    "Load Demo Camera Capabilities" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "载入演示相机能力" } } } },
    "No camera frames, audio, permission request, device identity, free text, persistence, history, diagnostics values, or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不读取相机画面或音频，不请求权限，不读取设备身份或自由文本，不持久化，也不进入历史、诊断值或导出。" } } } },
    "No supported local camera was discovered." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未发现受支持的本地相机。" } } } },
    "No valid capability rows were reported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未报告有效的能力行。" } } } },
    "None" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无" } } } },
