    "Sensor access is read-only. Unavailable sources stay isolated from the rest of the app." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传感器访问为只读；不可用的数据源不会影响应用的其他部分。" } } } },
    "Set Current as Reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将当前值设为参考" } } } },
    "The current spectral sample cannot be used as a reference" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前光谱样本无法作为参考" } } } },
    "The support report contains sensor availability and channel types, but no readings." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "支持报告包含传感器可用性和通道类型，但不包含读数。" } } } },
    "The lid-angle sensor could not be opened" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开上盖角度传感器" } } } },
    "The lid-angle sensor is not available on this Mac" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 不提供上盖角度传感器" } } } },
    "The lid-angle sensor is temporarily busy" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上盖角度传感器暂时繁忙" } } } },
    "This fingerprint compares light sources on this Mac; it is not a color-temperature measurement." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个指纹用于比较本机上的光源变化，不是色温测量。" } } } },
    "Required reading unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所需读数不可用" } } } },
