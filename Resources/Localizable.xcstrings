{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld detached interfaces • %lld malformed fields omitted" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已省略 %lld 个脱离设备的接口 • %lld 个异常字段" } } } },
    "%lld devices • %lld interfaces in this snapshot" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本次快照包含 %lld 个设备 • %lld 个接口" } } } },
    "Alternate setting" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备用设置" } } } },
    "Application specific" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用程序专用" } } } },
