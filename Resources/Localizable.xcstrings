    "Security" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安全模式" } } } },
    "Shows current public radio metrics without network identity or scanning" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示当前公开无线电指标，不读取网络身份或进行扫描" } } } },
    "Signal and noise are current radio-link readings; transmit rate is the negotiated PHY rate, not application throughput." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信号和噪声是当前无线链路读数；传输速率是协商后的 PHY 速率，不是应用吞吐量。" } } } },
