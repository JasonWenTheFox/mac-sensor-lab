    "No active display detected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未检测到活动显示器" } } } },
    "No compatible Apple SPU report devices found" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未发现兼容的 Apple SPU 报告设备" } } } },
    "No internal battery detected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未检测到内置电池" } } } },
    "No known Apple SPU sensors detected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未检测到已知的 Apple SPU 传感器" } } } },
    "Nominal" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正常" } } } },
    "Not detected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未检测到" } } } },
    "On" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开" } } } },
    "Only a fixed %@ and generation-neutral allowlist of temperature, fan and power keys was read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅读取固定的 %@ 与代际中立温度、风扇和功率键白名单。" } } } },
    "Provider output rejected by the safety contract" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Provider 输出被安全契约拒绝" } } } },
    "Raw read-only SMC key %@; model-specific meaning." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始只读 SMC 键 %@；含义因机型而异。" } } } },
    "Read %@ • Write %@" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取 %@ • 写入 %@" } } } },
    "Reading in the background…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在后台读取…" } } } },
    "Recent live data • waiting for a new SPU report" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最近的实时数据 • 正在等待新的 SPU 报告" } } } },
    "Reported full-charge capacity ÷ design capacity; not Apple's Battery Health status." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "报告满充容量 ÷ 设计容量；并非 Apple 的电池健康状态。" } } } },
    "Serious" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "较高" } } } },
    "Sensors detected, but macOS is not currently publishing reports" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到传感器，但 macOS 当前未发布报告" } } } },
    "Showing the last successful sample from %@ seconds ago; its original timestamp is preserved." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示 %@ 秒前最后一次成功采样；保留其原始时间戳。" } } } },
    "SMC opened, but common keys returned no readings" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SMC 已打开，但常用键没有返回读数" } } } },
    "SMC opened, but the %@ key allowlist returned no readings" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SMC 已打开，但 %@ 键白名单没有返回读数" } } } },
    "Spectral channel %lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "光谱通道 %lld" } } } },
    "SPU enumeration failed" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SPU 枚举失败" } } } },
    "SPU interfaces are temporarily busy" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SPU 接口暂时繁忙" } } } },
    "SPU interfaces were detected but could not be opened" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到 SPU 接口，但无法打开" } } } },
    "Standard lid-angle HID interface not found" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未找到标准上盖角度 HID 接口" } } } },
    "System performance counters were unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统性能计数器不可用" } } } },
    "Thermal pressure %@" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "热压力%@" } } } },
    "Uncalibrated raw channel." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未校准的原始通道。" } } } },
    "Uncalibrated raw intensity; not asserted to be lux." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未校准的原始强度；不声称单位为 lux。" } } } },
    "Undocumented hardware interface; model-specific validation is required." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未文档化的硬件接口；需要按机型验证。" } } } },
    "Unknown" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未知" } } } },
    "Voltage × current; not wall-plug power." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电压 × 电流；并非插座侧功率。" } } } },
    "Yes" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "是" } } } },
