    "Miscellaneous" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其他类别" } } } },
    "No serial numbers, names, locations, registry paths, descriptors, device opens, persistence, history, diagnostics values, or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不读取序列号、名称、位置、注册表路径或描述符，不打开设备，不持久化，不进入历史、诊断值或导出。" } } } },
    "Not connected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未连接" } } } },
    "Not reported" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未报告" } } } },
    "Other reported speed" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其他报告速度" } } } },
    "Personal healthcare" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "个人医疗保健" } } } },
    "Physical" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "物理接口" } } } },
    "Printer" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打印机" } } } },
    "Read Current USB Tree" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取当前 USB 树" } } } },
    "Reading the current bounded USB tree…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在读取有界的当前 USB 树…" } } } },
    "Reads one bounded USB registry snapshot only after you ask. Model-level numeric identifiers remain on this page for this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在你主动操作后读取一次有界 USB 注册表快照。型号级数字标识只在本次会话的此页面保留。" } } } },
    "Smart card" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "智能卡" } } } },
    "Stopped waiting after two seconds; any late result will be discarded." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待两秒后已停止；任何迟到结果都会被丢弃。" } } } },
    "SuperSpeed — 5 Gb/s" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SuperSpeed — 5 Gb/s" } } } },
    "SuperSpeed+ — 10 Gb/s" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SuperSpeed+ — 10 Gb/s" } } } },
    "SuperSpeed+ ×2 — 20 Gb/s" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SuperSpeed+ ×2 — 20 Gb/s" } } } },
    "The USB registry read failed without exposing system error text." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 注册表读取失败，未回显系统错误文本。" } } } },
    "The USB topology changed or was invalid while being read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取期间 USB 拓扑发生变化或无效。" } } } },
    "The USB tree exceeded its safety limit and was not shown." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 树超过安全上限，因此未显示。" } } } },
    "The registry read may still be finishing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注册表读取可能仍在结束。" } } } },
    "The registry snapshot contained no USB devices." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注册表快照中没有 USB 设备。" } } } },
    "This Mac does not expose the required public USB registry service." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 Mac 未公开所需的公共 USB 注册表服务。" } } } },
    "Top-level USB device" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "顶层 USB 设备" } } } },
    "USB Device %lld" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 设备 %lld" } } } },
    "USB Device Tree" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 设备树" } } } },
    "USB registry enumeration is temporarily unavailable." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 注册表枚举暂时不可用。" } } } },
    "USB tree available on this page for this session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 树仅在本次会话的此页面可用。" } } } },
    "USB tree available with malformed or detached records omitted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "USB 树可用；已省略异常或脱离设备的记录。" } } } },
    "Vendor ID / Product ID" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "厂商 ID / 产品 ID" } } } },
    "Vendor specific" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "厂商专用" } } } },
    "Video" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "视频" } } } },
    "Wireless controller" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无线控制器" } } } },
    "macOS did not permit this USB registry read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 未允许此次 USB 注册表读取。" } } } },
    "Allow microphone input for Sound Input Check?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许“声音输入检查”使用麦克风输入吗？" } } } },
    "Analyzing PCM buffers in memory." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在内存中分析 PCM 缓冲区。" } } } },
    "Bounded level history" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有界电平历史" } } } },
    "Check Permission Again" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新检查权限" } } } },
    "Continue to macOS Permission" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续前往 macOS 权限确认" } } } },
    "Elapsed seconds" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已过秒数" } } } },
    "Frequency Hz" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "频率 Hz" } } } },
    "Frequency resolution" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "频率分辨率" } } } },
    "Idle — demo mode will not access the microphone." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲——演示模式不会访问麦克风。" } } } },
    "Idle — microphone input has not started." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲——麦克风输入尚未开始。" } } } },
    "Latest waveform envelope" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最新波形包络" } } } },
    "Latest relative spectrum" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最新相对频谱" } } } },
    "Maximum amplitude" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最大幅度" } } } },
    "Microphone access is denied. Change it in System Settings if desired, then check again." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风访问已被拒绝。如需可在“系统设置”中更改，然后重新检查。" } } } },
    "Microphone access is restricted by the current system policy." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前系统策略限制了麦克风访问。" } } } },
    "Minimum amplitude" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最小幅度" } } } },
    "No enabled microphone input format was available." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可用的已启用麦克风输入格式。" } } } },
    "No non-DC spectral peak" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无非直流频谱峰值" } } } },
    "Observed buffers" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已观察缓冲区" } } } },
    "Observed PCM frames" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已观察 PCM 帧" } } } },
    "PCM channels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PCM 通道数" } } } },
    "PCM sample rate" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PCM 采样率" } } } },
    "Peak amplitude" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "峰值幅度" } } } },
    "Peak dBFS" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "峰值 dBFS" } } } },
    "Peak level" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "峰值电平" } } } },
    "Raw PCM is inspected only inside the audio callback and immediately reduced to bounded derived values. No samples, recordings, device identity, persistence, snapshot, diagnostics values, or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始 PCM 只在音频回调内检查，并立即归约为有界派生值。不保留样本、录音或设备身份，不持久化，也不进入快照、诊断值或导出。" } } } },
    "Review the privacy explanation before continuing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续前请查看隐私说明。" } } } },
    "Relative magnitude dB" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相对幅度 dB" } } } },
    "RMS amplitude" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RMS 幅度" } } } },
    "RMS dBFS" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RMS dBFS" } } } },
    "RMS level" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "RMS 电平" } } } },
    "Run Demo Sound Input" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行演示声音输入" } } } },
    "Sound Input Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音输入检查" } } } },
    "Spectrum FFT size" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "频谱 FFT 尺寸" } } } },
    "Spectrum floor" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "频谱显示下限" } } } },
    "Sound input stopped after an invalid PCM buffer." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到无效 PCM 缓冲区后已停止声音输入。" } } } },
    "Sound input stopped at the five-minute safety limit." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音输入已在五分钟安全上限处停止。" } } } },
    "Sound input stopped because a counter exceeded its safety limit." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "某项计数超过安全上限，声音输入已停止。" } } } },
    "Sound input stopped because the app is closing." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "App 正在关闭，声音输入已停止。" } } } },
    "Sound input stopped because the audio-device configuration changed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音频设备配置已变化，声音输入已停止。" } } } },
    "Sound input stopped before the Mac went to sleep." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 进入睡眠前已停止声音输入。" } } } },
    "Sound input stopped; counters and bounded derived analysis remain until this page is left." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音输入已停止；计数和有界派生分析会保留到离开本页。" } } } },
    "Start Sound Input Check" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始声音输入检查" } } } },
    "Starting the bounded audio input session…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在启动有界的音频输入会话…" } } } },
    "Starts a bounded microphone session only after an explicit action and derives a waveform envelope, RMS, peak, dBFS, and a relative frequency spectrum in memory." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在明确操作后启动有界的麦克风会话，并在内存中派生波形包络、RMS、峰值、dBFS 和相对频谱。" } } } },
    "Strongest non-DC bin center" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最强非直流分箱中心" } } } },
    "Stop Sound Input" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止声音输入" } } } },
    "The audio input session could not start." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法启动音频输入会话。" } } } },
    "The microphone permission request did not produce a decision." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风权限请求未产生明确结果。" } } } },
    "The latest spectrum uses at most 2,048 recent channel-averaged frames, removes the mean, applies a Hann window, and reduces positive frequencies to at most 128 bands. It refreshes no faster than 10 Hz." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最新频谱使用最多 2,048 个近期的通道平均帧，移除均值，应用 Hann 窗，并将正频率归约为最多 128 个频带。刷新频率不超过 10 Hz。" } } } },
    "The strongest value is the center of a finite-resolution FFT bin. It does not identify a sound source, musical pitch, speech, or the surrounding environment." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最强值是有限分辨率 FFT 分箱的中心频率。它不识别声源、音高、语音或周边环境。" } } } },
    "Up to 128 min/max bins from the latest buffer after averaging channels per frame." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对每帧的各通道取平均后，从最新缓冲区生成最多 128 个最小/最大值分箱。" } } } },
    "Waiting for the macOS microphone decision…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待 macOS 的麦克风权限决定…" } } } },
    "Waveform bin" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "波形分箱" } } } },
    "dBFS uses digital full scale 1.0; it is not dBA, sound-pressure level, or calibrated loudness. The history chart clips values below −96 dBFS, while exact digital silence is reported as −∞ dBFS. Spectrum values are relative to the current non-DC peak, not dBFS or SPL." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "dBFS 以数字满刻度 1.0 为基准；它不是 dBA、声压级或校准响度。历史图会裁剪低于 −96 dBFS 的值，精确的数字静音则报告为 −∞ dBFS。频谱值相对于当前非直流峰值，不是 dBFS 或 SPL。" } } } },
    "macOS will ask for microphone access. Capture begins only if you allow it; buffers stay in memory and are never saved or exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 将请求麦克风访问权限。只有在你允许后才会开始采集；缓冲区仅留在内存中，绝不保存或导出。" } } } },
    "Access level and compatibility evidence remain visible on every card." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每张卡片都会显示访问级别与兼容性证据。" } } } },
    "%@ points" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 点" } } } },
    "Calibrate This Display" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "校准这块显示器" } } } },
    "Calibration exists only for this app session and this display mode." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "校准仅在本次 App 会话和当前显示模式下有效。" } } } },
    "Clear Display Calibration" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除显示校准" } } } },
    "Current display ready for a session-only calibration." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前显示器已可进行仅限本次会话的校准。" } } } },
    "Display configuration changed. The previous calibration was discarded." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示配置已变化，先前的校准已丢弃。" } } } },
    "Display ruler is unavailable in Demo mode because it must use the real screen geometry." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示尺需要使用真实屏幕几何信息，因此在演示模式下不可用。" } } } },
    "Enter 10–2000 mm and choose a line width that produces a plausible 10–2000 PPI result." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入 10–2000 mm，并选择能得到合理 10–2000 PPI 结果的线段宽度。" } } } },
    "Locating the display containing this window…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在定位当前窗口所在的显示器…" } } } },
    "Match the on-screen line to a real ruler to calibrate only the current horizontal axis." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将屏幕线段与真实尺具对齐，只校准当前水平轴。" } } } },
    "Millimeters per point" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每点毫米数" } } } },
    "On-screen reference line, %@ points" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕参考线，%@ 点" } } } },
    "Physical Display Ruler" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示器物理尺" } } } },
    "Reference length" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参考长度" } } } },
    "Reference length in millimeters" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参考长度（毫米）" } } } },
    "Rendered ruler width" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕尺宽度" } } } },
    "Session display %lld • %lld × %lld points • %lld × %lld pixels" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本次会话显示器 %lld • %lld × %lld 点 • %lld × %lld 像素" } } } },
    "System estimated horizontal span" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统估算水平跨度" } } } },
    "System estimated PPI" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统估算 PPI" } } } },
    "The current window could not be bound to an active display." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前窗口无法绑定到活动显示器。" } } } },
    "User calibrated horizontal PPI" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用户校准水平 PPI" } } } },
    "User calibrated horizontal span" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用户校准水平跨度" } } } },
    "User-referenced horizontal calibration is active for this display mode." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前显示模式已启用用户参考的水平校准。" } } } },
    "User-referenced, not certified metrology. Only the horizontal axis is calibrated; vertical size and diagonal are not inferred." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结果来自用户参考，不是认证计量。只校准水平轴，不推断垂直尺寸或对角线。" } } } },
    "Capture stopped. Samples remain only until cleared or this page is left." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采集已停止。样本只保留到清除或离开本页为止。" } } } },
    "Clear Pressure Samples" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除压力样本" } } } },
    "Click and press here with a Force Touch trackpad" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 Force Touch 触控板在此点击并继续按压" } } } },
    "Force Touch Pressure Lab" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Force Touch 压力实验" } } } },
    "Force Touch pressure interaction area" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Force Touch 压力交互区" } } } },
    "Force Touch service detected. Start a local capture when ready." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已检测到 Force Touch 服务。准备好后可开始本地采集。" } } } },
    "Force Touch service not detected. Start a local capture to check the active input device." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未检测到 Force Touch 服务。可开始本地采集以检查当前输入设备。" } } } },
    "Keep the pointer inside this area during the gesture." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "操作期间请让指针保持在此区域内。" } } } },
    "No global input monitoring, raw contacts, device identifiers, persistence, or export." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不进行全局输入监控，不读取原始触点或设备标识，也不持久化或导出。" } } } },
    "Normalized pressure" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "归一化压力" } } } },
    "Normalized pressure trend with %lld samples" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "归一化压力趋势，共 %lld 个样本" } } } },
    "Peak in current stage" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前阶段内峰值" } } } },
    "Pressure Lab is unavailable in Demo mode because it requires live local input." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "压力实验需要本机实时输入，因此在演示模式下不可用。" } } } },
    "Pressure is normalized from 0 to 1 within each stage. It is not force, weight, grams, or a calibrated physical measurement." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "压力值在每个阶段内归一化为 0 到 1。它不是力、重量、克数或经过校准的物理测量。" } } } },
    "Reads public AppKit pressure events only inside the interaction area below." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只在下方交互区域内读取公开的 AppKit 压力事件。" } } } },
    "Receiving view-local AppKit pressure events." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在接收仅限当前视图的 AppKit 压力事件。" } } } },
    "Retained samples" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留样本数" } } } },
    "Stage" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "阶段" } } } },
    "Stage 2 entries" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "进入阶段 2 次数" } } } },
    "Stage transition" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "阶段过渡量" } } } },
    "Start Pressure Capture" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始压力采集" } } } },
    "Start a local capture to check the current input device." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始本地采集以检查当前输入设备。" } } } },
    "Stop Pressure Capture" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止压力采集" } } } },
    "The curve is split at every stage change; values from different stages are never added together." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "曲线会在每次阶段变化处分段；不同阶段的数值不会相加。" } } } },
    "The last click did not advertise pressure events. Try the Force Touch trackpad." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上次点击未声明支持压力事件。请尝试使用 Force Touch 触控板。" } } } },
    "Waiting for pressure events inside the interaction area." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在等待交互区域内的压力事件。" } } } },
