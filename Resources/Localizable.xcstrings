    "System storage hardware facts were unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统存储硬件事实不可用" } } } },
    "CoreGraphics and AppKit display capabilities" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "CoreGraphics 与 AppKit 显示能力" } } } },
    "Disk Arbitration whole-disk description" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Disk Arbitration 整盘描述" } } } },
    "Display slots are session-local order labels, not persistent identifiers." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示器序号仅表示本次会话的顺序，不是持久标识符。" } } } },
    "CoreGraphics may estimate physical size at 72 DPI when EDID is unavailable, so physical dimensions and PPI remain Estimated." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "EDID 不可用时 CoreGraphics 可能按 72 DPI 估算物理尺寸，因此物理尺寸和 PPI 始终标为估算值。" } } } },
    "Localized display names, display IDs, EDID data, ICC profile names, and serial numbers are intentionally omitted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有意省略显示器名称、显示 ID、EDID 数据、ICC 配置名称和序列号。" } } } },
    "No display identifiers, localized names, EDID blobs, or serial numbers are read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不读取显示器标识符、本地化名称、EDID 数据或序列号。" } } } },
    "Only the whole-disk object associated with the current system volume is summarized." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅汇总与当前系统卷关联的整盘对象。" } } } },
    "Device model, vendor, revision, serial number, GUID, UUID, BSD name, registry path, volume name, and mount path are intentionally omitted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有意省略设备型号、厂商、修订、序列号、GUID、UUID、BSD 名称、registry 路径、卷名和挂载路径。" } } } },
    "SMART and NVMe health fields are not inferred from Disk Arbitration metadata." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不会根据 Disk Arbitration 元数据推断 SMART 或 NVMe 健康字段。" } } } },
    "No device path, identifier, model, or system error text is exported." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不导出设备路径、标识符、型号或系统错误文本。" } } } },
    "A shared model-class identifier, not a unique device identifier." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这是同类机型共享的标识符，不是设备唯一标识。" } } } },
    "A shared product-family name, not a chip identifier." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这是共享的产品系列名称，不是芯片唯一标识。" } } } },
